{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rulecheck policy v1",
  "description": "Rulecheck also validates byte limits, unique IDs, relative paths, and glob and regex syntax.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "sets": {
      "description": "Named, reusable exclusion glob sets. The builder reads each from .rulecheck/sets/<name>.set.ts in the same worktree or commit as the rules.",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/set" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "kind", "paths", "remediation", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
        "kind": { "enum": ["text", "forbidden-path", "syntax"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "anchors": {
          "description": "Forbidden-path rules only. Globs for files that show the guarded area exists. When no file matches any anchor, the check cannot judge and exits 2. Without anchors, no matching forbidden path is always a pass.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "excludeSets": {
          "description": "Names of sets whose globs are added to exclude. A rule resolves at most 256 distinct exclusion globs.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/setName" }
        },
        "skipIfContent": {
          "description": "Skips an in-scope file whose first firstBytes bytes contain a literal or match a regex. Text and syntax rules only. A file that cannot be read is never skipped.",
          "type": "object",
          "required": ["kind", "value", "firstBytes"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "firstBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
          }
        },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "pattern": {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "requires": {
          "description": "Text rules only. Text that must appear somewhere in the same file when pattern matches: a file where pattern matches and requires does not reports each pattern match, and a file that also matches requires reports none. A regex that can match empty text is refused.",
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "selector": { "$ref": "#/$defs/selector" },
        "provenance": {
          "type": "object",
          "required": ["finding"],
          "additionalProperties": false,
          "properties": {
            "finding": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://[^\\p{White_Space}\\p{Cc}]+$"
            }
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/fixture" }
        }
      },
      "if": { "properties": { "kind": { "const": "text" } } },
      "then": {
        "required": ["pattern"],
        "not": { "required": ["selector"] },
        "properties": { "anchors": { "not": {} }, "fixtures": { "items": { "required": ["content"] } } }
      },
      "else": {
        "if": { "properties": { "kind": { "const": "syntax" } } },
        "then": {
          "required": ["selector"],
          "not": { "required": ["pattern"] },
          "properties": {
            "anchors": { "not": {} },
            "requires": { "not": {} },
            "fixtures": { "items": { "required": ["content"], "properties": { "expectAll": { "not": {} } } } }
          }
        },
        "else": {
          "not": { "required": ["pattern"] },
          "properties": {
            "selector": { "not": {} },
            "requires": { "not": {} },
            "skipIfContent": { "not": {} },
            "fixtures": {
              "items": { "not": { "required": ["content"] }, "properties": { "expectAll": { "not": {} } } }
            }
          }
        }
      }
    },
    "setName": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
    "set": {
      "description": "Includes nest at most 4 levels counting the set a rule names, and must not form a cycle.",
      "type": "object",
      "required": ["name", "version", "globs"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/setName" },
        "version": { "const": 1 },
        "globs": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/setName" }
        }
      }
    },
    "selector": {
      "description": "Selects nodes of one named tree-sitter node kind. typescript parses .ts, .mts and .cts files with the TypeScript grammar and .tsx files with the TSX grammar, and Rulecheck checks node kinds and fields against both. rust parses .rs files with the Rust grammar, go parses .go files with the Go grammar, and python parses .py and .pyi files with the Python grammar.",
      "type": "object",
      "required": ["language", "node"],
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["typescript", "rust", "go", "python"] },
        "node": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inside": {
          "type": "object",
          "required": ["kinds"],
          "additionalProperties": false,
          "properties": {
            "kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "field": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "ignore": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["kind", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["literal", "regex"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    },
    "fixture": {
      "description": "Asserts the first match with expect (null for none), or, for text rules, every match in --all-matches order with expectAll. Use exactly one.",
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "oneOf": [{ "required": ["expect"] }, { "required": ["expectAll"] }],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content": { "type": "string" },
        "expect": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/location" }
          ]
        },
        "expectAll": {
          "description": "Every match location in ascending order, without duplicates. An empty list expects no match.",
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["line", "column"],
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
