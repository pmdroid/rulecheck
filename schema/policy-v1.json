{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rulecheck policy v1",
  "description": "Rulecheck also validates byte limits, unique IDs, relative paths, and glob and regex syntax.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "sets": {
      "description": "Named, reusable exclusion glob sets. The builder reads each from .rulecheck/sets/<name>.set.ts in the same worktree or commit as the rules.",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/set" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "kind", "paths", "remediation", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
        "kind": { "enum": ["text", "forbidden-path", "syntax", "structured", "consistency"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "anchors": {
          "description": "Forbidden-path rules only. Globs for files that show the guarded area exists. When no file matches any anchor, the check cannot judge and exits 2. Without anchors, no matching forbidden path is always a pass.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "excludeSets": {
          "description": "Names of sets whose globs are added to exclude. A rule resolves at most 256 distinct exclusion globs.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/setName" }
        },
        "skipIfContent": {
          "description": "Skips an in-scope file whose first firstBytes bytes contain a literal or match a regex. Text, syntax and structured rules only. A file that cannot be read is never skipped.",
          "type": "object",
          "required": ["kind", "value", "firstBytes"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 },
            "firstBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
          }
        },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "message": {
          "description": "Optional per-finding detail for a regex text rule: plain text with {name} references to the pattern's named groups, and {{ or }} for a literal brace. Rulecheck checks every reference when the policy loads and reports the rendered text in a finding's message, beside the fixed remediation.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "pattern": {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "requires": {
          "description": "Text rules only. Text that must appear somewhere in the same file when pattern matches: a file where pattern matches and requires does not reports each pattern match, and a file that also matches requires reports none. A regex that can match empty text is refused.",
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "selector": { "$ref": "#/$defs/selector" },
        "structure": { "$ref": "#/$defs/structure" },
        "consistency": { "$ref": "#/$defs/consistency" },
        "provenance": {
          "type": "object",
          "required": ["finding"],
          "additionalProperties": false,
          "properties": {
            "finding": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://[^\\p{White_Space}\\p{Cc}]+$"
            }
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/fixture" }
        }
      },
      "if": { "properties": { "kind": { "const": "text" } } },
      "then": {
        "required": ["pattern"],
        "properties": {
          "selector": { "not": {} },
          "structure": { "not": {} },
          "consistency": { "not": {} },
          "anchors": { "not": {} },
          "fixtures": { "items": { "required": ["content"], "properties": { "files": { "not": {} } } } }
        }
      },
      "else": {
        "if": { "properties": { "kind": { "const": "structured" } } },
        "then": {
          "required": ["structure"],
          "properties": {
            "pattern": { "not": {} },
            "selector": { "not": {} },
            "anchors": { "not": {} },
            "requires": { "not": {} },
            "message": { "not": {} },
            "consistency": { "not": {} },
            "fixtures": { "items": { "required": ["content"], "properties": { "files": { "not": {} } } } }
          }
        },
        "else": {
          "if": { "properties": { "kind": { "const": "syntax" } } },
          "then": {
            "required": ["selector"],
            "properties": {
              "pattern": { "not": {} },
              "structure": { "not": {} },
              "anchors": { "not": {} },
              "requires": { "not": {} },
              "message": { "not": {} },
              "consistency": { "not": {} },
              "fixtures": {
                "items": { "required": ["content"], "properties": { "expectAll": { "not": {} }, "files": { "not": {} } } }
              }
            }
          },
          "else": {
            "if": { "properties": { "kind": { "const": "forbidden-path" } } },
            "then": {
              "properties": {
                "pattern": { "not": {} },
                "selector": { "not": {} },
                "structure": { "not": {} },
                "requires": { "not": {} },
                "skipIfContent": { "not": {} },
                "message": { "not": {} },
                "consistency": { "not": {} },
                "fixtures": {
                  "items": {
                    "not": { "required": ["content"] },
                    "properties": { "expectAll": { "not": {} }, "files": { "not": {} } }
                  }
                }
              }
            },
            "else": {
              "required": ["consistency"],
              "properties": {
                "pattern": { "not": {} },
                "selector": { "not": {} },
                "structure": { "not": {} },
                "requires": { "not": {} },
                "anchors": { "not": {} },
                "skipIfContent": { "not": {} },
                "message": { "not": {} },
                "fixtures": { "items": { "required": ["files", "expectFindings"] } }
              }
            }
          }
        }
      }
    },
    "setName": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
    "set": {
      "description": "Includes nest at most 4 levels counting the set a rule names, and must not form a cycle.",
      "type": "object",
      "required": ["name", "version", "globs"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/setName" },
        "version": { "const": 1 },
        "globs": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "include": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/setName" }
        }
      }
    },
    "selector": {
      "description": "Selects nodes of one named tree-sitter node kind. typescript parses .ts, .mts and .cts files with the TypeScript grammar and .tsx files with the TSX grammar, and Rulecheck checks node kinds and fields against both. rust parses .rs files with the Rust grammar, go parses .go files with the Go grammar, and python parses .py and .pyi files with the Python grammar.",
      "type": "object",
      "required": ["language", "node"],
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["typescript", "rust", "go", "python"] },
        "node": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inside": {
          "type": "object",
          "required": ["kinds"],
          "additionalProperties": false,
          "properties": {
            "kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "field": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "ignore": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["kind", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["literal", "regex"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    },
    "structure": {
      "description": "Reads .yml and .yaml files as YAML, without executing or expanding anything, and walks path in every document. present reports a document where the path selects nothing; absent, equals, not-equals and has-key report every selected node that breaks the assertion. Scalars compare by their text after unquoting. Duplicate keys, malformed input, aliases and << merge keys on the path cannot be judged.",
      "type": "object",
      "required": ["format", "path", "assert"],
      "additionalProperties": false,
      "if": { "properties": { "assert": { "properties": { "kind": { "enum": ["present", "absent"] } } } } },
      "then": { "properties": { "path": { "minItems": 1 } } },
      "properties": {
        "format": { "enum": ["yaml"] },
        "path": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/structurePathSegment" }
        },
        "assert": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["present", "absent", "equals", "not-equals", "has-key"] },
            "value": { "type": "string", "maxLength": 1024 },
            "key": { "type": "string", "minLength": 1, "maxLength": 1024 }
          },
          "oneOf": [
            {
              "properties": { "kind": { "enum": ["present", "absent"] }, "value": { "not": {} }, "key": { "not": {} } }
            },
            {
              "required": ["value"],
              "properties": { "kind": { "enum": ["equals", "not-equals"] }, "key": { "not": {} } }
            },
            {
              "required": ["key"],
              "properties": { "kind": { "const": "has-key" }, "value": { "not": {} } }
            }
          ]
        }
      }
    },
    "structurePathSegment": {
      "description": "key selects a mapping value by its key text, index a zero-based sequence item, each every mapping value or sequence item.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "key": { "type": "string", "maxLength": 1024 },
        "index": { "type": "integer", "minimum": 0 },
        "each": { "enum": ["mapping", "sequence"] }
      },
      "oneOf": [{ "required": ["key"] }, { "required": ["index"] }, { "required": ["each"] }]
    },
    "consistency": {
      "description": "Consistency rules only. Each scope selects files inside the rule's paths, exclude and excludeSets, and extract captures one value per match. A value is trimmed of surrounding whitespace, an empty value is dropped and a repeated value counts once. A scope extracts at most 10000 values of at most 1024 bytes. same-values reports each value found in one scope but not the other, at its first occurrence. path-exists reports each reference that does not resolve to a regular file of the rule's inventory; a reference resolves lexically from the repository root or from the referencing file's directory, and one that is absolute, contains a backslash, control character, empty segment or .git, or climbs above the root is reported as escaping the repository. A scope with no file, or a symlink or submodule in the rule's scope, exits 2.",
      "type": "object",
      "required": ["form"],
      "oneOf": [
        {
          "required": ["left", "right"],
          "additionalProperties": false,
          "properties": {
            "form": { "const": "same-values" },
            "left": { "$ref": "#/$defs/consistencyScope" },
            "right": { "$ref": "#/$defs/consistencyScope" }
          }
        },
        {
          "required": ["source", "base"],
          "additionalProperties": false,
          "properties": {
            "form": { "const": "path-exists" },
            "source": { "$ref": "#/$defs/consistencyScope" },
            "base": { "enum": ["root", "file"] }
          }
        }
      ]
    },
    "consistencyScope": {
      "type": "object",
      "required": ["name", "paths", "extract"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/setName" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "extract": {
          "description": "A Rust regex with exactly one capture group, around the value. Use (?m) for ^ and $ at line boundaries.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "fixture": {
      "description": "Asserts the first match with expect (null for none), or, for text rules, every match in --all-matches order with expectAll. Use exactly one. A consistency fixture instead lists a synthetic inventory in files and every finding the rule reports on it in expectFindings.",
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        { "required": ["path", "expect"] },
        { "required": ["path", "expectAll"] },
        { "required": ["files", "expectFindings"] }
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content": { "type": "string" },
        "expect": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/location" }
          ]
        },
        "expectAll": {
          "description": "Every match location in ascending order, without duplicates. An empty list expects no match.",
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "files": {
          "description": "Consistency fixtures only: the inventory's files. A file in a scope that extracts values needs content.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["path"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
              "content": { "type": "string" }
            }
          }
        },
        "expectFindings": {
          "description": "Consistency fixtures only: every finding, ordered by path, then line and column, without duplicates. An empty list expects none.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "line", "column"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["line", "column"],
      "additionalProperties": false,
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
