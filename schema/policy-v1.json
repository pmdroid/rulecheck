{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rulecheck policy v1",
  "description": "Rulecheck also validates byte limits, unique IDs, relative paths, and glob and regex syntax.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "kind", "paths", "remediation", "fixtures"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
        "kind": { "enum": ["text", "forbidden-path", "syntax"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "pattern": {
          "type": "object",
          "required": ["kind", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["literal", "regex"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        },
        "selector": { "$ref": "#/$defs/selector" },
        "provenance": {
          "type": "object",
          "required": ["finding"],
          "additionalProperties": false,
          "properties": {
            "finding": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^https://[^\\p{White_Space}\\p{Cc}]+$"
            }
          }
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/fixture" }
        }
      },
      "if": { "properties": { "kind": { "const": "text" } } },
      "then": {
        "required": ["pattern"],
        "not": { "required": ["selector"] },
        "properties": { "fixtures": { "items": { "required": ["content"] } } }
      },
      "else": {
        "if": { "properties": { "kind": { "const": "syntax" } } },
        "then": {
          "required": ["selector"],
          "not": { "required": ["pattern"] },
          "properties": { "fixtures": { "items": { "required": ["content"] } } }
        },
        "else": {
          "not": { "required": ["pattern"] },
          "properties": {
            "selector": { "not": {} },
            "fixtures": { "items": { "not": { "required": ["content"] } } }
          }
        }
      }
    },
    "selector": {
      "description": "Selects nodes of one named tree-sitter node kind. typescript parses .ts, .mts and .cts files with the TypeScript grammar and .tsx files with the TSX grammar, and Rulecheck checks node kinds and fields against both. rust parses .rs files with the Rust grammar.",
      "type": "object",
      "required": ["language", "node"],
      "additionalProperties": false,
      "properties": {
        "language": { "enum": ["typescript", "rust"] },
        "node": { "type": "string", "minLength": 1, "maxLength": 128 },
        "inside": {
          "type": "object",
          "required": ["kinds"],
          "additionalProperties": false,
          "properties": {
            "kinds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "field": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "ignore": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["kind", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": { "enum": ["literal", "regex"] },
              "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["path", "expect"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "content": { "type": "string" },
        "expect": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["line", "column"],
              "additionalProperties": false,
              "properties": {
                "line": { "type": "integer", "minimum": 1 },
                "column": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        }
      }
    }
  }
}
