{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rulecheck rule inventory v1",
  "description": "Written to stdout by rulecheck list --format json. Rules are sorted by ID and each rule's tags are sorted, so the same policy always gives the same document. Treat an unknown inventoryVersion as unreadable.",
  "type": "object",
  "required": ["inventoryVersion", "tools", "policy", "rules"],
  "additionalProperties": false,
  "properties": {
    "inventoryVersion": { "const": 1 },
    "tools": {
      "type": "object",
      "required": ["evaluator"],
      "additionalProperties": false,
      "properties": {
        "evaluator": { "type": "string", "pattern": "^rulecheck " }
      }
    },
    "policy": {
      "type": "object",
      "required": ["version", "sha256", "idPrefix"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "Digest of the policy bytes the evaluator read, as in check results." },
        "idPrefix": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "kind", "tags", "provenance", "remediation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
        "kind": { "enum": ["text", "forbidden-path", "syntax", "structured", "consistency"] },
        "tags": {
          "description": "Sorted and unique. Empty when the rule has no tags.",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" }
        },
        "provenance": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["finding"],
              "additionalProperties": false,
              "properties": { "finding": { "type": "string", "pattern": "^https://" } }
            }
          ]
        },
        "remediation": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    }
  }
}
